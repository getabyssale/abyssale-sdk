{
  "name": "@abyssale/sdk",
  "version": "1.2.0",
  "description": "Official Node.js/TypeScript SDK for programmatic image generation, animated banners, and print-ready PDFs via the Abyssale API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "generate": "node scripts/fetch-spec.mjs spec.stripped.json && openapi-typescript spec.stripped.json -o src/generated.ts && node -e \"require('node:fs').unlinkSync('spec.stripped.json')\"",
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p examples/tsconfig.json",
    "prepublishOnly": "npm run generate && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "openapi-fetch": "^0.13"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^2"
  },
  "keywords": [
    "abyssale",
    "image-generation",
    "banner-generation",
    "programmatic-design",
    "creative-automation",
    "dynamic-images",
    "multi-format",
    "asset-generation",
    "design-automation",
    "sdk",
    "typescript"
  ],
  "author": "Abyssale <dev@abyssale.com>",
  "homepage": "https://developers.abyssale.com",
  "bugs": "https://github.com/getabyssale/abyssale-sdk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/getabyssale/abyssale-sdk"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
